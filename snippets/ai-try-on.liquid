{% comment %}
  Luxury AI Virtual Try-On Studio - Refined Next-Gen Interface
  Supports: Clothing, Jewellery, and accessories via Generative AI Fusion.
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
  :root {
    --v-primary: #6366f1;
    --v-primary-hover: #4f46e5;
    --v-secondary: #a855f7;
    --v-bg-dark: #0f172a;
    --v-card-bg: rgba(30, 41, 59, 0.7);
    --v-glass-border: rgba(255, 255, 255, 0.1);
    --v-text-main: #f8fafc;
    --v-text-muted: #94a3b8;
    --v-accent: #10b981;
    --v-glow: rgba(99, 102, 241, 0.5);
  }

  .v-tryon-wrapper {
    margin: 20px 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  /* Main Button Styling */
  .v-trigger-btn {
    width: 100%;
    padding: 16px 28px;
    background: linear-gradient(135deg, var(--v-primary), var(--v-secondary));
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3);
    position: relative;
    overflow: hidden;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .v-trigger-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: 0.5s;
  }

  .v-trigger-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 25px rgba(99, 102, 241, 0.4);
  }

  .v-trigger-btn:hover::before {
    left: 100%;
  }

  .v-trigger-btn svg {
    width: 24px;
    height: 24px;
    filter: drop-shadow(0 0 5px rgba(255,255,255,0.5));
  }

  /* Modal Styling */
  .v-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(2, 6, 23, 0.85);
    backdrop-filter: blur(12px);
    z-index: 10000;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .v-modal.active {
    display: flex;
    opacity: 1;
  }

  .v-modal-content {
    background: var(--v-card-bg);
    border: 1px solid var(--v-glass-border);
    border-radius: 32px;
    width: 100%;
    max-width: 1000px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  @media (max-width: 768px) {
    .v-modal-content {
      grid-template-columns: 1fr;
    }
  }

  .v-modal-close {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--v-glass-border);
    border-radius: 50%;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
  }

  .v-modal-close:hover {
    background: rgba(239, 68, 68, 0.2);
    border-color: #ef4444;
  }

  /* Left Panel: Preview/Scan */
  .v-left-panel {
    background: rgba(0, 0, 0, 0.2);
    padding: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-right: 1px solid var(--v-glass-border);
    position: relative;
    overflow: hidden;
  }

  .v-preview-container {
    width: 100%;
    aspect-ratio: 3/4;
    background: rgba(255, 255, 255, 0.02);
    border: 2px dashed var(--v-glass-border);
    border-radius: 24px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .v-preview-container.drag-over {
    border-color: var(--v-primary);
    background: rgba(99, 102, 241, 0.05);
  }

  .v-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }

  .v-upload-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    color: var(--v-text-muted);
    text-align: center;
    padding: 20px;
  }

  .v-upload-placeholder svg {
    width: 64px;
    height: 64px;
    opacity: 0.5;
    color: var(--v-primary);
  }

  /* Right Panel: Controls */
  .v-right-panel {
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .v-modal-header h2 {
    font-size: 28px;
    font-weight: 800;
    margin-bottom: 8px;
    background: linear-gradient(to right, #fff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .v-modal-header p {
    color: var(--v-text-muted);
    font-size: 15px;
  }

  .v-control-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .v-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--v-text-main);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .v-input-file {
    display: none;
  }

  .v-upload-btn {
    padding: 12px 20px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--v-glass-border);
    border-radius: 12px;
    color: white;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    transition: all 0.3s ease;
  }

  .v-upload-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--v-primary);
  }

  .v-generate-btn {
    margin-top: auto;
    padding: 18px;
    background: var(--v-primary);
    color: white;
    border: none;
    border-radius: 16px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .v-generate-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .v-generate-btn:not(:disabled):hover {
    background: var(--v-primary-hover);
    transform: scale(1.02);
  }

  /* Scanning Animation */
  .v-scan-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(to bottom, transparent, var(--v-primary), transparent);
    box-shadow: 0 0 15px var(--v-primary);
    z-index: 5;
    display: none;
    animation: scan 2s linear infinite;
  }

  @keyframes scan {
    0% { top: 0; }
    100% { top: 100%; }
  }

  /* Result View */
  .v-result-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--v-bg-dark);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 20;
  }

  .v-result-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: fadeIn 0.8s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  .v-loader-orb {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--v-primary);
    filter: blur(20px);
    animation: pulse 1.5s infinite alternate;
    opacity: 0.6;
  }

  @keyframes pulse {
    from { transform: scale(0.8); opacity: 0.4; }
    to { transform: scale(1.2); opacity: 0.8; }
  }

  .v-loading-text {
    position: absolute;
    bottom: 40px;
    color: white;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 12px;
  }

  /* Category Badge */
  .v-category-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(5px);
    border: 1px solid var(--v-glass-border);
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    color: white;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .v-category-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--v-accent);
    box-shadow: 0 0 10px var(--v-accent);
  }
</style>

<div class="v-tryon-wrapper" id="vto-app-{{ product.id }}">
  <button class="v-trigger-btn" id="v-open-modal">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"/>
      <path d="M12 8v8m-4-4h8"/>
    </svg>
    <span>Virtual Try-On</span>
  </button>

  <div class="v-modal" id="v-modal">
    <div class="v-modal-content">
      <button class="v-modal-close" id="v-close-modal">✕</button>
      
      <!-- Left Panel: Visualization -->
      <div class="v-left-panel">
        <div class="v-category-badge">
          <span class="v-category-dot"></span>
          <span id="v-category-name">DETECTING CATEGORY...</span>
        </div>

        <div class="v-preview-container" id="v-drop-zone">
          <div class="v-scan-line" id="v-scan-line"></div>
          
          <div class="v-upload-placeholder" id="v-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4m4-5l5-5 5 5m-5-5v12"/>
            </svg>
            <div>
              <p style="font-weight: 700; color: #fff; margin-bottom: 4px;">Upload Your Portrait</p>
              <p style="font-size: 13px;">Drag & drop or click to browse</p>
            </div>
          </div>
          
          <img src="" class="v-preview-img" id="v-user-img">

          <div class="v-result-overlay" id="v-result-overlay">
            <div class="v-loader-orb" id="v-orb"></div>
            <p class="v-loading-text" id="v-status-text">AI IS GENERATING...</p>
            <img src="" class="v-result-img" id="v-final-img">
          </div>
        </div>
      </div>

      <!-- Right Panel: Actions -->
      <div class="v-right-panel">
        <div class="v-modal-header">
          <h2>AI Fashion Studio</h2>
          <p>Experience how this product looks on you with high-fidelity generative AI.</p>
        </div>

        <div class="v-control-group">
          <label class="v-label">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
            </svg>
            STEP 1: YOUR PHOTO
          </label>
          <input type="file" id="v-file-input" class="v-input-file" accept="image/*">
          <button class="v-upload-btn" onclick="document.getElementById('v-file-input').click()">
            SELECT PORTRAIT
          </button>
        </div>

        <div class="v-control-group">
          <label class="v-label">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/>
            </svg>
            STEP 2: PRODUCT INFO
          </label>
          <div style="background: rgba(255,255,255,0.03); padding: 15px; border-radius: 12px; border: 1px solid var(--v-glass-border); display: flex; gap: 15px; align-items: center;">
            <img src="{{ product.featured_media | img_url: '100x' }}" style="width: 50px; height: 50px; border-radius: 8px; object-fit: cover;">
            <div>
              <p style="font-weight: 700; font-size: 14px; margin: 0;">{{ product.title }}</p>
              <p style="font-size: 12px; color: var(--v-text-muted); margin: 4px 0 0;">{{ product.type | default: 'Fashion' }}</p>
            </div>
          </div>
        </div>

        <button class="v-generate-btn" id="v-generate-btn" disabled>
          GENERATE TRY-ON
        </button>

        <div style="margin-top: auto; padding: 15px; background: rgba(16, 185, 129, 0.05); border-radius: 12px; border: 1px solid rgba(16, 185, 129, 0.2); display: flex; gap: 12px; align-items: center;">
          <div id="v-status-dot" style="width: 8px; height: 8px; border-radius: 50%; background: var(--v-accent);"></div>
          <p id="v-status-badge" style="font-size: 11px; color: var(--v-accent); font-weight: 600; text-transform: uppercase;">AI Engine Active: High Fidelity Mode</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  const container = document.getElementById('vto-app-{{ product.id }}');
  const openBtn = container.querySelector('#v-open-modal');
  const closeBtn = container.querySelector('#v-close-modal');
  const modal = container.querySelector('#v-modal');
  const fileInput = container.querySelector('#v-file-input');
  const generateBtn = container.querySelector('#v-generate-btn');
  const userImg = container.querySelector('#v-user-img');
  const placeholder = container.querySelector('#v-placeholder');
  const scanLine = container.querySelector('#v-scan-line');
  const resultOverlay = container.querySelector('#v-result-overlay');
  const finalImg = container.querySelector('#v-final-img');
  const statusText = container.querySelector('#v-status-text');
  const orb = container.querySelector('#v-orb');
  const categoryName = container.querySelector('#v-category-name');
  const dropZone = container.querySelector('#v-drop-zone');

  // Product Data
  const productType = "{{ product.type | downcase }}";
  const productTitle = "{{ product.title }}";
  const productImage = "{{ product.featured_media | img_url: '1024x' }}";
  
  // Set Category
  const tags = "{{ product.tags | join: ',' | downcase }}";
  if (productType.includes('jewel') || productType.includes('ring') || productType.includes('necklace') || tags.includes('jewel') || tags.includes('accessory')) {
    categoryName.innerText = "JEWELLERY PRECISION MODE";
  } else if (productType.includes('cloth') || productType.includes('dress') || productType.includes('shirt') || tags.includes('apparel') || tags.includes('clothing')) {
    categoryName.innerText = "OUTFIT FUSION MODE";
  } else {
    categoryName.innerText = "SMART FUSION MODE";
  }

  // Server Status Check
  const statusDot = container.querySelector('#v-status-dot');
  const statusBadge = container.querySelector('#v-status-badge');
  
  async function checkServer() {
    try {
      const resp = await fetch('https://try-on-featuress-cr21.vercel.app/');
      if (resp.ok) {
        statusDot.style.background = 'var(--v-accent)';
        statusBadge.innerText = 'AI Engine Active: High Fidelity Mode';
        statusBadge.style.color = 'var(--v-accent)';
      } else {
        throw new Error();
      }
    } catch {
      statusDot.style.background = '#ef4444';
      statusBadge.innerText = 'AI Engine: Temporary Maintenance';
      statusBadge.style.color = '#ef4444';
    }
  }
  checkServer();

  // Modal Handlers
  openBtn.onclick = () => modal.classList.add('active');
  closeBtn.onclick = () => {
    modal.classList.remove('active');
    resetState();
  };

  function resetState() {
    resultOverlay.style.display = 'none';
    finalImg.style.display = 'none';
    orb.style.display = 'block';
    statusText.innerText = 'AI IS GENERATING...';
    scanLine.style.display = 'none';
  }

  // File Selection
  fileInput.onchange = (e) => {
    const file = e.target.files[0];
    if (file) handleFile(file);
  };

  // Drag & Drop
  dropZone.ondragover = (e) => {
    e.preventDefault();
    dropZone.classList.add('drag-over');
  };
  dropZone.ondragleave = () => dropZone.classList.remove('drag-over');
  dropZone.ondrop = (e) => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    if (file) handleFile(file);
  };

  function handleFile(file) {
    const reader = new FileReader();
    reader.onload = (e) => {
      userImg.src = e.target.result;
      userImg.style.display = 'block';
      placeholder.style.display = 'none';
      generateBtn.disabled = false;
    };
    reader.readAsDataURL(file);
  }

  // Generation Logic
  generateBtn.onclick = async () => {
    const file = fileInput.files[0];
    if (!file) return;

    // Start UI
    scanLine.style.display = 'block';
    resultOverlay.style.display = 'flex';
    generateBtn.disabled = true;
    
    statusText.innerText = "ANALYZING POSE & LIGHTING...";

    try {
      // Step 1: Prepare data
      const formData = new FormData();
      formData.append('userPhoto', file);
      formData.append('size', '768x1344');

      // Convert product image URL to blob to ensure compatibility with file-upload backends
      const productBlob = await fetch(productImage).then(r => r.blob());
      formData.append('productImage', productBlob, 'product.jpg');
      
      formData.append('prompt', `A realistic virtual try-on of ${productTitle} (${productType}) on the person in the photo. High fidelity, professional lighting.`);

      // Mock progress messages
      setTimeout(() => statusText.innerText = "FUSING PRODUCT TEXTURES...", 3000);
      setTimeout(() => statusText.innerText = "FINALIZING GENERATIVE DETAILS...", 6000);

      // Call Backend
      const response = await fetch('https://try-on-featuress-cr21.vercel.app/api/tryon', {
        method: 'POST',
        body: formData
      });

      if (!response.ok) throw new Error('AI Engine Offline');

      const data = await response.json();
      
      // Success!
      if (data.success && data.resultImage) {
        finalImg.src = data.resultImage;
        finalImg.onload = () => {
          orb.style.display = 'none';
          statusText.innerText = "MASTERPIECE COMPLETE";
          finalImg.style.display = 'block';
          scanLine.style.display = 'none';
        };
      } else {
        throw new Error(data.error || 'Generation failed');
      }

    } catch (error) {
      console.error(error);
      statusText.innerText = "AI ENGINE TEMPORARILY OFFLINE";
      orb.style.background = "#ef4444";
      setTimeout(() => {
        resetState();
        generateBtn.disabled = false;
      }, 3000);
    }
  };
})();
</script>
