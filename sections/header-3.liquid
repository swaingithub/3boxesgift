                {%- if section.settings.header_wishlist -%}
                    {% render 'wishlist-header' %}
                {%- endif -%}

                {%- comment -%}
                  {%- if section.settings.header_sign -%}    
                    {%- render 'header-sign' -%}
                  {%- endif -%} 
                {%- endcomment -%}

                {%- if settings.main_menu == 'vertical-menu' -%}
                  <div class="showmenu d-none d-lg-block">
                    <i class="leofa-bars"></i>
                  </div>
                {%- endif -%}

                <div class="showmenu d-none d-lg-block">
                  <i class="leofa-bars"></i>
                </div>
            </div>
            <!-- block menu -->
            <div class=" header-menubar header-align-{% if section.settings.logo_align_2 == 'left' %}center{% else %}left{% endif %}">
              
              {%- render 'block-menu' -%}
            </div>
          </div>
          
          <!-- header-card -->
          {%- if section.settings.header_card -%}
            <div class="col-xl-2 col-lg-4 col-12 header-card-box">
              {%- render 'icon-megamenu-mobile' -%}
              <div class="header-card-box-con">
                <!-- <div class="img-card d-none d-md-block">
                  <img src="{{ section.settings.img_quantity | img_url: 'master' }}" alt="">
                </div>
                <div class="icon-card-tow d-block d-md-none">
                  {% render 'icon-card-home3' %}
                </div> -->
                {%- render 'header-cart' -%}
              </div>
            </div>
          {%- endif -%}
         
            
          
      </div>
  </div>
</header>

{% schema %}
{
  "name": "t:sections.header-3.name",
  "class": "spaced-header",
  "tag": "section",
  "settings": [
      {
        "type": "checkbox",
        "id": "fullwidth",
        "label": "t:sections.header-3.settings.fullwidth.label",
        "default": false
      },
      
      {
        "type": "checkbox",
        "id": "currencies",
        "label": "t:sections.header-3.settings.currencies.label",
        "default": true
      },
      {
        "type": "header",
        "content": "t:sections.header-3.settings.header_2.content"
      },
      {
        "id": "background-color",
        "type": "color",
        "label": "t:sections.header-3.settings.background-color.label"
      },
      {
        "id": "logo_align_2",
        "type": "select",
        "options": [
          {
            "value": "left",
            "label": "t:sections.header-3.settings.logo_align_2.options__1.label"
          },
          {
            "value": "center",
            "label": "t:sections.header-3.settings.logo_align_2.options__2.label"
          }
        ],
        "default": "left",
        "label": "t:sections.header-3.settings.logo_align_2.label"
      },
      {
        "type": "checkbox",
        "id": "header_seach",
        "label": "t:sections.header-3.settings.header_seach.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_sign",
        "label": "t:sections.header-3.settings.header_sign.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_wishlist",
        "label": "t:sections.header-3.settings.header_wishlist.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_card",
        "label": "t:sections.header-3.settings.header_card.label",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "img_quantity",
        "label": "t:sections.header-4.settings.img_quantity.label"
      }
      ]
}

{% endschema %}
