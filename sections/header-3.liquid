  <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
      <div class="row header-center">
        
        <!-- logo -->
          <div class="col-12 col-xl-2 head-logo logo-align-{% if section.settings.logo_align_2 == 'left' %}left{% else %}center{% endif %}">
              {% render 'header-logo' %}
          </div>
          <!-- icon and block menu -->
          <div class="col-xl-8 col-lg-8 col-12 header-infor">
            <!-- icon -->
              <div class=" header-icon">
  
                  <div class=" d-flex header-3-announcement-bar-right">
                    {%- if section.settings.header_sign -%}
                      <div class="sign-in popup-over">
