<!-- wrapper.liquid -->
{{ 'wrapper.css' | asset_url | stylesheet_tag }}
{% render 'section-style' %}

<div class="wrapper" {% if section.settings.show_bg_wrapper %} style="background: url( {{ section.settings.bg_wrapper | img_url:'master' }} );" {% endif %} >
    <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}" style="background: {{ section.settings.bg_color }};" > 
      <div class="text-center">
        <h2 class="title-block">{{ section.settings.heading | escape }}</h2>
        <p class="section-text">{{ section.settings.text_decoration }}</p>
      </div>
      
      <div class="row">
            {% for block in section.blocks %}
                
                  {%- case block.settings.width -%}
                      {%- when '25%' -%}
                      {%- assign block_width = 'col-lg-3 col-sm-6' -%}
                      {%- when '33%' -%}
                      {%- assign block_width = 'col-xl-4 col-lg-6 col-md-6 col-sm-12' -%}
                      {%- when '50%' -%}
                      {%- assign block_width = 'col-lg-6 col-sm-12' -%}
                      {%- when '66%' -%}
                      {%- assign block_width = 'col-lg-8 col-md-12' -%}
                      {%- when '75%' -%}
                      {%- assign block_width = 'col-lg-9 col-md-9' -%}
                      {%- when '100%' -%}
                      {%- assign block_width = 'col-12' -%}
                      {%- endcase -%}
                      {%- case block.type -%}
                        {%- when 'blog' -%}
                            <div class=" {{block_width}} blog-row">
                                <div class="blog-post ">
                                    <div class="{%- if block.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
                                        <h2 class="section-header title-block">{{ block.settings.heading | escape }}</h2>
                                        <p class="section-text">{{ block.settings.text_decoration }}</p>
                                        
                                        <div class="blog-list blog-slick apslick"
                                            data-setting='{"accessibility": false, "arrows": {{ block.settings.arrows }},
                                            "dots": {{ block.settings.dots }}, "draggable": {{ block.settings.draggable }},
                                            "infinite": {{ block.settings.infinite }}, "autoplay": {{ block.settings.autoplay }},
                                            "autoplaySpeed": {{ block.settings.autoplaySpeed }}, "speed": {{ block.settings.speed }},
                                            "slidesToShow": {{ block.settings.slidesToShow }}, "slidesToScroll": {{ block.settings.slidesToScroll }},
                                            "vertical": false, "mobileFirst": false, "pauseOnHover": {{ block.settings.pauseOnHover }},
                                            "rows": {{ block.settings.rows }}, "slidesPerRow": 1, "rtl": {% if settings.enable_rtl %}1{% else %}0{% endif %},
                                            "slidesToShow_992": {{ block.settings.slidesToShow_992 }}, "slidesToScroll_992": {{ block.settings.slidesToScroll_992 }},
                                            "arrows_992": {{ block.settings.arrows_992 }}, "dots_992": {{ block.settings.dots_992 }},
                                            "slidesToShow_767": {{ block.settings.slidesToShow_767 }}, "slidesToScroll_767": {{ block.settings.slidesToScroll_767 }},
                                            "arrows_767": {{ block.settings.arrows_767 }}, "dots_767": {{ block.settings.dots_767 }},
                                            "slidesToShow_450": {{ block.settings.slidesToShow_450 }}, "slidesToScroll_450": {{ block.settings.slidesToScroll_450 }},
                                            "arrows_450": {{ block.settings.arrows_450 }}, "dots_450": {{ block.settings.dots_450 }}}'>
                                            {%- for article in block.settings.blog.articles -%}
                                            <div class="blog-items blog-layout-items-1">
                                                <a class="blog-link" href="{{ article.url }}">
                                                    <div class="blog-row-box">
                                                            <div class="article-card__image media"
                                                        style="padding-bottom: {{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;"
                                                        >
                                                        <img
                                                            srcset="{%- if article.image.src.width >= 165 -%}{{ article.image.src | img_url: '165x' }} 165w,{%- endif -%}
                                                            {%- if article.image.src.width >= 360 -%}{{ article.image.src | img_url: '360x' }} 360w,{%- endif -%}
                                                            {%- if article.image.src.width >= 533 -%}{{ article.image.src | img_url: '533x' }} 533w,{%- endif -%}
                                                            {%- if article.image.src.width >= 720 -%}{{ article.image.src | img_url: '720x' }} 720w,{%- endif -%}
                                                            {%- if article.image.src.width >= 1000 -%}{{ article.image.src | img_url: '1000x' }} 1000w,{%- endif -%}
                                                            {%- if article.image.src.width >= 1500 -%}{{ article.image.src | img_url: '1500x' }} 1500w,{%- endif -%}"
                                                            src="{{ article.image.src | img_url: 'master' }}"
                                                            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                                                            alt="{{ article.image.src.alt | escape }}"
                                                            width="{{ article.image.width }}"
                                                            height="{{ article.image.height }}"
                                                            loading="lazy"
                                                            class="motion-reduce"
                                                        >
                                                        </div>
                                                        <div class="blog-content">
                                                            <h2 class="blog-title">
                                                                {{ article.title | escape }}
                                                            </h2>
                                                            <div class="blog-content-box">
                                                                {%- if block.settings.show_date -%}
                                                                    <span class="blog-date">
                                                                    {{- article.published_at | time_tag: "%d %B %Y" -}}
                                                                    </span>
                                                                {%- endif -%}
                                                                {%- if block.settings.show_author -%}
                                                                    <span class="blog-author">{{ article.author -}}</span>
                                                                {%- endif -%}
                                                                {%- if block.settings.show_description -%}
                                                                <p class="blog-description">
                                                                {%- if article.excerpt.size > 0 -%}
                                                                    {{ article.excerpt | strip_html | truncatewords: 20 }}
                                                                {%- else -%}
                                                                    {{ article.content | strip_html | truncatewords: 20 }}
                                                                {%- endif -%}
                                                                </p>
                                                                {%- endif -%}
                                                                {%- if block.settings.tags_blog -%}
                                                                    <p class="blog__meta">
                                                                        {%- if article.tags.size > 0 -%}
                                                                        {%- for tag in article.tags -%}
                                                                        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="link-body-color"><strong>{{ tag }}</strong></a>{% unless forloop.last %}, {% endunless %}
                                                                        {%- endfor -%}
                                                                        {%- endif -%}
                                                                    </p>
                                                                {%- endif -%}
                                                            </div>
                                                            
                                                        </div>
                                                    </div>
                                                    
                                                </a>
                                            </div>
                                            {%- endfor -%}
                                            {%- if block.settings.blog == blank -%}
                                            {%- for i in (1..6) -%}
                                            <div class="blog-items">
                                                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                                            </div>
                                            {%- endfor -%}
                                            {%- endif -%}
                                        </div>
                                        {%- if block.settings.show_view_all -%}
                                            <div class="btn-view-blog">
                                                <a class="link-blog-all" href="{{ block.settings.blog.url }}">
                                                {{ block.settings.view_all }}
                                                </a>
                                            </div>
                                            {%- endif -%}
                                    </div>
                                </div>
                            </div>
                        {%- when 'image' -%}
                            <div class="{{block_width}} card-image">
                                <div class="card-image-box">
                                    <div class="image">
                                        <h2 class="title-block">{{ block.settings.heading | escape }}</h2>
                                        <div class="image-list">
                                            <div class="clear-fix">
                                                <div class="row image-list-content">
                                                    <div class="col-4 image-item">
                                                        <img src="{{ block.settings.image1 | img_url:'master' }}" alt="">
                                                    </div>
                                                    <div class="col-4 image-item">
                                                        <img src="{{ block.settings.image2 | img_url:'master' }}" alt="">
                                                    </div>
                                                    <div class="col-4 image-item">
                                                        <img src="{{ block.settings.image3 | img_url:'master' }}" alt="">
                                                    </div>
                                                    <div class="col-4 image-item">
                                                        <img src="{{ block.settings.image4 | img_url:'master' }}" alt="">
                                                    </div>
                                                    <div class="col-4 image-item">
                                                        <img src="{{ block.settings.image5 | img_url:'master' }}" alt="">
                                                    </div>
                                                    <div class="col-4 image-item">
                                                        <img src="{{ block.settings.image6 | img_url:'master' }}" alt="">
                                                    </div>
                                                </div>
                                            </div>  
                                        </div>
                                    </div>
                                    <div class="foot-image">
                                        <div class="bottom">
                                            <p>{{ block.settings.foot_image }}</p>
                                        </div>
                                    </div>
                                </div>
                                
                            </div>
                        {%- when 'slide' -%}
                              <div class="{{block_width}} blog-column">
                                  <div class="blog-post ">
                                          <h2 class="section-header title-block">{{ block.settings.heading | escape }}</h2>
                                          <p class="section-text">{{ block.settings.text_decoration }}</p>
                                          
                                          <div class="blog-list blog-slick apslick"
                                              data-setting='{"accessibility": false, "arrows": {{ block.settings.arrows }},
                                              "dots": {{ block.settings.dots }}, "draggable": {{ block.settings.draggable }},
                                              "infinite": {{ block.settings.infinite }}, "autoplay": {{ block.settings.autoplay }},
                                              "autoplaySpeed": {{ block.settings.autoplaySpeed }}, "speed": {{ block.settings.speed }},
                                              "slidesToShow": {{ block.settings.slidesToShow }}, "slidesToScroll": {{ block.settings.slidesToScroll }},
                                              "vertical": false, "mobileFirst": false, "pauseOnHover": {{ block.settings.pauseOnHover }},
                                              "rows": {{ block.settings.rows }}, "slidesPerRow": 1, "rtl": {% if settings.enable_rtl %}1{% else %}0{% endif %},
                                              "slidesToShow_992": {{ block.settings.slidesToShow_992 }}, "slidesToScroll_992": {{ block.settings.slidesToScroll_992 }},
                                              "arrows_992": {{ block.settings.arrows_992 }}, "dots_992": {{ block.settings.dots_992 }},
                                              "slidesToShow_767": {{ block.settings.slidesToShow_767 }}, "slidesToScroll_767": {{ block.settings.slidesToScroll_767 }},
                                              "arrows_767": {{ block.settings.arrows_767 }}, "dots_767": {{ block.settings.dots_767 }},
                                              "slidesToShow_450": {{ block.settings.slidesToShow_450 }}, "slidesToScroll_450": {{ block.settings.slidesToScroll_450 }},
                                              "arrows_450": {{ block.settings.arrows_450 }}, "dots_450": {{ block.settings.dots_450 }}}'>
                                              {%- for article in block.settings.blog.articles -%}
                                              <div class="blog-items blog-layout-items-1">
                                                  <a class="blog-link" href="{{ article.url }}">
                                                      <div class="blog-row-box">
                                                              <div class="article-card__image media"
                                                          style="padding-bottom: {{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;"
                                                          >
                                                          <img
                                                              srcset="{%- if article.image.src.width >= 165 -%}{{ article.image.src | img_url: '165x' }} 165w,{%- endif -%}
                                                              {%- if article.image.src.width >= 360 -%}{{ article.image.src | img_url: '360x' }} 360w,{%- endif -%}
                                                              {%- if article.image.src.width >= 533 -%}{{ article.image.src | img_url: '533x' }} 533w,{%- endif -%}
                                                              {%- if article.image.src.width >= 720 -%}{{ article.image.src | img_url: '720x' }} 720w,{%- endif -%}
                                                              {%- if article.image.src.width >= 1000 -%}{{ article.image.src | img_url: '1000x' }} 1000w,{%- endif -%}
                                                              {%- if article.image.src.width >= 1500 -%}{{ article.image.src | img_url: '1500x' }} 1500w,{%- endif -%}"
                                                              src="{{ article.image.src | img_url: 'master' }}"
                                                              sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                                                              alt="{{ article.image.src.alt | escape }}"
                                                              width="{{ article.image.width }}"
                                                              height="{{ article.image.height }}"
                                                              loading="lazy"
                                                              class="motion-reduce"
                                                          >
                                                          </div>
                                                          <div class="blog-content">
                                                              <h2 class="blog-title">
                                                                  {{ article.title | escape }}
                                                              </h2>
                                                              <div class="blog-content-box">
                                                                  {%- if block.settings.show_date -%}
                                                                      <span class="blog-date">
                                                                      {{- article.published_at | time_tag: "%d %B %Y" -}}
                                                                      </span>
                                                                  {%- endif -%}
                                                                  {%- if block.settings.show_author -%}
                                                                      <span class="blog-author">{{ article.author -}}</span>
                                                                  {%- endif -%}
                                                                  {%- if block.settings.show_description -%}
                                                                  <p class="blog-description">
                                                                  {%- if article.excerpt.size > 0 -%}
                                                                      {{ article.excerpt | strip_html | truncatewords: 20 }}
                                                                  {%- else -%}
                                                                      {{ article.content | strip_html | truncatewords: 20 }}
                                                                  {%- endif -%}
                                                                  </p>
                                                                  {%- endif -%}
                                                                  {%- if block.settings.tags_blog -%}
                                                                      <p class="blog__meta">
                                                                          {%- if article.tags.size > 0 -%}
                                                                          {%- for tag in article.tags -%}
                                                                          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="link-body-color"><strong>{{ tag }}</strong></a>{% unless forloop.last %}, {% endunless %}
                                                                          {%- endfor -%}
                                                                          {%- endif -%}
                                                                      </p>
                                                                  {%- endif -%}
                                                              </div>
                                                              
                                                          </div>
                                                      </div>
                                                      
                                                  </a>
                                              </div>
                                              {%- endfor -%}
                                              {%- if block.settings.blog == blank -%}
                                              {%- for i in (1..6) -%}
                                              <div class="blog-items">
                                                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                                              </div>
                                              {%- endfor -%}
                                              {%- endif -%}
                                          </div>
                                          {%- if block.settings.show_view_all -%}
                                              <div class="btn-view-blog">
                                                  <a class="link-blog-all" href="{{ block.settings.blog.url }}">
                                                  {{ block.settings.view_all }}
                                                  </a>
                                              </div>
                                          {%- endif -%}
                                  </div>
                              </div>
                        {%- when 'image_singer' -%}
                              <div class="{{block_width}} image-singer">
                                <!-- <img src="{{ block.settings.image1 | img_url: 'master' }}" alt=""> -->
                                <div class="image" {% if block.settings.text1 != blank or block.settings.text2 != blank %} style="width: 50%;" {%- else -%} style="width: 100%;" {% endif %} >
                                  {%- if block.settings.image1 != blank -%}
                                
                                  <img class="advanced__image1"
                                  srcset="{%- if block.settings.image1.width >= 165 -%}{{ block.settings.image1 | img_url: '165x' }} 165w,{%- endif -%}
                                    {%- if block.settings.image1.width >= 360 -%}{{ block.settings.image1 | img_url: '360x' }} 360w,{%- endif -%}
                                    {%- if block.settings.image1.width >= 480 -%}{{ block.settings.image1 | img_url: '480x' }} 480w,{%- endif -%}
                                    {%- if block.settings.image1.width >= 850 -%}{{ block.settings.image1 | img_url: '850x' }} 850w,{%- endif -%}
                                    {%- if block.settings.image1.width >= 1200 -%}{{ block.settings.image1 | img_url: '1300x' }} 1300w,{%- endif -%}
                                    {%- if block.settings.image1.width >= 1500 -%}{{ block.settings.image1 | img_url: '1500x' }} 1500w,{%- endif -%}"
                                  src="{{ block.settings.image1 | img_url: 'master' }}"
                                  sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                                  alt="{{ block.settings.image1.alt | escape }}"
                                  loading="lazy"
                                  width="{{ block.settings.image1.width }}"
                                  height="{{ block.settings.image1.height }}"
                                  >
                                  {%- else -%}
                                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                                  {%- endif -%}
                                </div>
                                {% if block.settings.text1 != blank or block.settings.text2 != blank %}
                                  <div class="text-image" >
                                    <h4>{{ block.settings.text1 }}</h4>
                                    <h3> {{ block.settings.text2 }} </h3>
                                    {%- if block.settings.btn_text != blank -%}
                                    <a class="button-content" href="{{ block.settings.btn_link | default:'#' }}" title="{{ block.settings.btn_text }}">
                                      <span>{{ block.settings.btn_text }}</span>
                                    </a>
                                    {%- endif -%}
                                  </div>
                                {%- endif -%}
                              </div>
                {%- endcase -%}
            {% endfor %}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.wrapper.name",
  "class": "spaced-section",
  "tag": "section",
  "settings": [
    {
        "type": "checkbox",
        "id": "fullwidth",
        "label": "t:sections.wrapper.settings.fullwidth.label",
        "default": false
    },
    {
        "type": "checkbox",
        "id": "show_bg_wrapper",
        "label": "t:sections.wrapper.settings.show_bg_wrapper.label",
        "default": false
    },
    {
        "type": "image_picker",
        "id": "bg_wrapper",
        "label": "t:sections.wrapper.settings.bg_wrapper.label"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "t:sections.wrapper.settings.bg_color.label"
  },
    {
      "id": "heading",
      "type": "text",
      "label": "t:sections.product-tab.settings.heading.label",
      "default": "Product tab"
    },
    {
      "type": "text",
      "id": "text_decoration",
      "label": "t:sections.product-tab.settings.text_decoration.label",
      "default": "Product tab"
    }
  ],


  
  "blocks":[
  {
    "type": "blog",
    "name": "t:sections.wrapper.blocks.blog.name",
    "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.banner-grid.blocks.image.settings.width.label",
      "default": "33%",
      "options": [
        {
          "value": "25%",
          "label": "t:sections.banner-grid.blocks.image.settings.width.options__1.label"
        },
        {
          "value": "33%",
          "label": "t:sections.banner-grid.blocks.image.settings.width.options__2.label"
        },
        {
          "value": "50%",
          "label": "t:sections.banner-grid.blocks.image.settings.width.options__3.label"
        },
        {
          "value": "66%",
          "label": "t:sections.banner-grid.blocks.image.settings.width.options__4.label"
        },
        {
          "value": "75%",
          "label": "t:sections.banner-grid.blocks.image.settings.width.options__5.label"
        },
        {
          "value": "100%",
          "label": "t:sections.banner-grid.blocks.image.settings.width.options__6.label"
        }
      ]
     },  
    {
        "type": "text",
        "id": "heading",
        "label": "t:sections.blog-carousel.settings.heading.label",
        "default": "blog-carousel"
    },
    {
        "type": "text",
        "id": "text_decoration",
        "label": "t:sections.blog-carousel.settings.text_decoration.label"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.blog-carousel.settings.blog.label"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.blog-carousel.settings.show_view_all.label",
      "default": true
    },
    
  {
    "type": "text",
    "id": "view_all",
    "label": "t:sections.blog-carousel.settings.view_all.label",
    "default": "View all"
  },
    {
        "type": "checkbox",
        "id": "show_date",
        "label": "t:sections.blog-carousel.settings.show_date.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_author",
        "label": "t:sections.blog-carousel.settings.show_author.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_description",
        "label": "t:sections.blog-carousel.settings.show_description.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "tags_blog",
        "label": "t:sections.blog-carousel.settings.tags_blog.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_link",
        "label": "t:sections.blog-carousel.settings.show_link.label",
        "default": false
      },
      {
        "type": "text",
        "id": "text_link",
        "label": "t:sections.blog-carousel.settings.text_link.label",
        "default": "Read More"
      },
      {
        "type": "range",
        "id": "slidesToShow",
        "min": 1,
        "max": 10,
        "step": 1,
        "label": "t:sections.blog-carousel.settings.slidesToShow.label",
        "default": 3
      },
      {
        "type": "range",
        "id": "slidesToScroll",
        "min": 1,
        "max": 10,
        "step": 1,
        "label": "t:sections.blog-carousel.settings.slidesToScroll.label",
        "default": 1
      },
      {
        "type": "range",
        "id": "rows",
        "min": 1,
        "max": 4,
        "step": 1,
        "label": "t:sections.blog-carousel.settings.rows.label",
        "default": 1
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "t:sections.blog-carousel.settings.autoplay.label",
        "default": false
      },
      {
        "type": "range",
        "id": "autoplaySpeed",
        "min": 1000,
        "max": 5000,
        "step": 1000,
        "label": "t:sections.blog-carousel.settings.autoplaySpeed.label",
        "default": 2000
      },
      {
        "type": "range",
        "id": "speed",
        "min": 300,
        "max": 1000,
        "step": 100,
        "label": "t:sections.blog-carousel.settings.speed.label",
        "default": 500
      },
      {
        "type": "checkbox",
        "id": "pauseOnHover",
        "label": "t:sections.blog-carousel.settings.pauseOnHover.label",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "arrows",
        "label": "t:sections.blog-carousel.settings.arrows.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "dots",
        "label": "t:sections.blog-carousel.settings.dots.label",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "draggable",
        "label": "t:sections.blog-carousel.settings.draggable.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "infinite",
        "label": "t:sections.blog-carousel.settings.infinite.label",
        "default": true
      },
      {
        "type": "header",
        "content": "t:sections.blog-carousel.settings.header.content"
      },
      {
        "type": "range",
        "id": "slidesToShow_992",
        "min": 1,
        "max": 10,
        "step": 1,
        "label": "t:sections.blog-carousel.settings.slidesToShow_992.label",
        "default": 3
      },
      {
        "type": "range",
        "id": "slidesToScroll_992",
        "min": 1,
        "max": 10,
        "step": 1,
        "label": "t:sections.blog-carousel.settings.slidesToScroll_992.label",
        "default": 3
      },
