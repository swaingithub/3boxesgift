<!-- header-4.liquid -->
{{ 'header-4.css' | asset_url | stylesheet_tag }}
{{ 'component-mini-cart.css' | asset_url | stylesheet_tag }}
{% render 'section-style' %}

<header
  class="header-4 color-{%- if section.settings.enable_transparent -%}transparent{%- else -%}{{ section.settings.color_scheme }}{%- endif -%} luxurious-header"
  style="position: sticky; top: 0; z-index: 100; width:100%;"
>
  <div class="container-fluid text-center luxurious-announcement-bar">
    <div class="row">
      <div class="col-12 my-1 p-2">
        <p class="my-1 luxurious-announcement-text">{{ section.settings.text_announcement_bar }}</p>
      </div>
    </div>
  </div>

