  <div
    class="header-4-center "
  >
    <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
      <div class="row align-items-center">
        <!-- Logo -->
        <div class="col-xl-3 col-lg-12 col-md-12 col-sm-12 col-xs-12 text-end center-logo">
          {%- render 'header-logo' -%}
        </div>

        <!-- Account and Cart Elements -->
        {%- if section.settings.show_service -%}
          <div class="col-xl-9 col-lg-9 col-md-6 d-flex justify-content-end align-items-center top-icons">
            <!-- {% render 'home-icon' %} -->

            <div class="header-luxury-icons d-flex justify-content-end align-items-center" style="width: 100%;">
              {%- if section.settings.header_wishlist -%}
                <div class="header-icon-item">{%- render 'wishlist-header' -%}</div>
              {%- endif -%}
              
              {%- if section.settings.header_sign -%}
                <div class="header-icon-item">{%- render 'home-icon' -%}</div>
                <div class="header-icon-item">{%- render 'header-sign' -%}</div>
              {%- endif -%}
              
              <div class="header-icon-item">{%- render 'header-cart' -%}</div>
            </div>
          </div>
        {%- endif -%}

        <!-- Additional Elements -->
        <div class="col-lg-9 col-xl-9 col-md-6 header-megamenu">
          {%- render 'block-menu' -%}
        </div>
        <div class="col-lg-3 col-xl-3 col-md-12 col-sm-9 col-7 header-mobi-mobile header-search">
          {%- render 'icon-megamenu-mobile' -%}
          <div class="box-search-cart">
            {%- if section.settings.header_seach -%}
              {%- render 'seach-header' -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--
    <div class="header-4-bottom">
      <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
        <div class="row">


        </div>
      </div>
    </div>
  -->
</header>

{% schema %}
{
  "name": "t:sections.header-4.name",
  "class": "spaced-header",
  "tag": "section",
  "settings": [
      {
        "type": "checkbox",
        "id": "fullwidth",
        "label": "t:sections.header-4.settings.fullwidth.label",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "header_announcement_bar",
        "label": "t:sections.header-4.settings.header_announcement_bar.label",
        "default": true
      },
      {
        "type": "text",
        "id": "text_announcement_bar",
        "label": "t:sections.header-4.settings.text_announcement_bar.label",
        "default": "Welcome to our store"
      },
      {
        "id": "color_scheme",
        "type": "select",
        "options": [
          {
            "value": "background-1",
            "label": "t:sections.header-4.settings.color_scheme.options__1.label"
          },
          {
            "value": "background-2",
            "label": "t:sections.header-4.settings.color_scheme.options__2.label"
          },
          {
            "value": "inverse",
            "label": "t:sections.header-4.settings.color_scheme.options__3.label"
          },
          {
            "value": "accent-1",
            "label": "t:sections.header-4.settings.color_scheme.options__4.label"
          },
          {
            "value": "accent-2",
            "label": "t:sections.header-4.settings.color_scheme.options__5.label"
          }
        ],
        "default": "background-1",
        "label": "t:sections.header-4.settings.color_scheme.label"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:sections.header-4.settings.logo.label"
      },
      {
        "id": "logo_align",
        "type": "select",
        "options": [
          {
            "value": "left",
            "label": "t:sections.header-4.settings.logo_align.options__1.label"
          },
          {
            "value": "center",
            "label": "t:sections.header-4.settings.logo_align.options__2.label"
          }
        ],
        "default": "left",
        "label": "t:sections.header-4.settings.logo_align.label"
      },

      {
        "type": "checkbox",
        "id": "show_header_announcement_right",
        "label": "t:sections.header-4.settings.show_header_announcement_right.label",
        "default": true
      },


      {
        "type": "checkbox",
        "id": "header_seach",
        "label": "t:sections.header-4.settings.header_seach.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_sign",
        "label": "t:sections.header-4.settings.header_sign.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_wishlist",
        "label": "t:sections.header-4.settings.header_wishlist.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "currencies",
        "label": "t:sections.header-4.settings.currencies.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_card",
        "label": "t:sections.header-4.settings.header_card.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_transparent",
        "label": "t:sections.header-4.settings.enable_transparent.label"
      },
      {
        "type": "text",
        "id": "link1",
        "label": "t:sections.header-4.settings.link1.label",
        "default":"About us"
      },
      {
        "type": "url",
        "id": "url_link1",
        "label": "t:sections.header-4.settings.url_link1.label"
      },
      {
        "type": "text",
        "id": "link2",
        "label": "t:sections.header-4.settings.link2.label",
        "default":"Track order"
      },
      {
        "type": "url",
        "id": "url_link2",
        "label": "t:sections.header-4.settings.url_link2.label"
      },
      {
        "type": "text",
        "id": "link3",
        "label": "t:sections.header-4.settings.link3.label",
        "default":"F.A.Qs"
      },
      {
        "type": "url",
        "id": "url_link3",
        "label": "t:sections.header-4.settings.url_link3.label"
      },
      {
        "type": "checkbox",
        "id": "show_service",
        "label": "t:sections.header-4.settings.show_service.label",
        "default":false
      },
      {
        "type": "image_picker",
        "id": "img_shipper",
        "label": "t:sections.header-4.settings.img_shipper.label"
      },
      {
        "type": "text",
        "id": "shipper",
        "label": "t:sections.header-4.settings.shipper.label",
        "default":"on all orders over $99"
      },
      {
        "type": "image_picker",
        "id": "img_calling",
        "label": "t:sections.header-4.settings.img_calling.label"
      },
      {
        "type": "text",
        "id": "calling",
        "label": "t:sections.header-4.settings.calling.label",
        "default":"012 - 345 - 6789"
      },
      {
        "type": "image_picker",
        "id": "img_quantity",
        "label": "t:sections.header-4.settings.img_quantity.label"
      }


      ]
}
{% endschema %}
