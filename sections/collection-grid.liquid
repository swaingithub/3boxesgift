<!-- collection.liquid -->
{{ 'collection-1.css' | asset_url | stylesheet_tag }}
{{ 'collection-grid.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{% render 'section-style' %}

<div class="collection-grid">
    <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
      <h2 class="section-header">{{ section.settings.heading | escape }}</h2>
      <p class="section-text">{{ section.settings.text_decoration }}</p>
        <div class="row collection-1-row">
            {%- for block in section.blocks -%}
            {%- case block.settings.width -%}
            {%- when '25%' -%}
            {%- assign block_width = 'col-lg-3 col-md-6 col-sm-6 col-6' -%}
            {%- when '33%' -%}
            {%- assign block_width = 'col-md-4 col-12' -%}
            {%- when '50%' -%}
            {%- assign block_width = 'col-lg-6' -%}
            {%- when '66%' -%}
            {%- assign block_width = 'col-lg-8 col-md-6' -%}
            {%- when '75%' -%}
            {%- assign block_width = 'col-lg-9 col-md-9' -%}
            {%- when '100%' -%}
            {%- assign block_width = 'col-12' -%}
            {%- endcase -%}
            <div class="{{block_width}} collection-item" >
                <!-- item 1 -->
                <div class="collection-1-content" style="background: {{ block.settings.bg_color_item }};">
                  <a class="link-collection-1" href="{{ block.settings.collection.url | default:'#' }}">
                    <div class="flex-fake">
                      <div class="collection-content collection-{% if section.settings.effects_image %}image-hover{% else %}image{% endif %} {% if block.settings.image_collection != blank %}media{% else %}image-collection__media--placeholder placeholder{% endif %}" style="padding-bottom: {{ 1 | divided_by: block.settings.image_collection.aspect_ratio | times: 100 }}%;" >
                        {%- if block.settings.image_collection != blank -%}
                        <img
                        srcset="{%- if block.settings.image_collection.width >= 165 -%}{{ block.settings.image_collection | img_url: '165x' }} 165w,{%- endif -%}
                          {%- if block.settings.image_collection.width >= 1500 -%}{{ block.settings.image_collection | img_url: '1500x' }} 1500w,{%- endif -%}"
                        src="{{ block.settings.image_collection | img_url: 'master' }}"
                        sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                        alt="{{ block.settings.image_collection.alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image_collection.width }}"
                        height="{{ block.settings.image_collection.height }}"
                      >
                      {%- else -%}
                      {%- capture current -%}{%- cycle 1, 2, 3, 4, 5, 6 -%}{%- endcapture -%}
                      {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                      </div>
                      <h3 class="title-collection-1  {% if block.settings.title_collection == "top" %} text-top {% else %} {% endif %} "><span class="{% if block.settings.add_border_bottom %} border-under {% endif %}">{{ block.settings.collection.title | escape }}{%- if block.settings.collection.title == blank -%}<span>Collection</span>{%- endif -%}</span></h3>
                    </div>
                </a>
                </div>
                <!-- item 2 -->
                <div class="collection-1-content" style="background: {{ block.settings.bg_color_item2 }};">
                    <a class="link-collection-1" href="{{ block.settings.collection2.url | default:'#' }}">
                    <div class="flex-fake">
                        <div class="collection-content collection-{% if section.settings.effects_image %}image-hover{% else %}image{% endif %} {% if block.settings.image_collection != blank %}media{% else %}image-collection__media--placeholder placeholder{% endif %}" style="padding-bottom: {{ 1 | divided_by: block.settings.image_collection2.aspect_ratio | times: 100 }}%;" >
                        {%- if block.settings.image_collection2 != blank -%}
                        <img
                        srcset="{%- if block.settings.image_collection2.width >= 165 -%}{{ block.settings.image_collection2 | img_url: '165x' }} 165w,{%- endif -%}
                            {%- if block.settings.image_collection2.width >= 1500 -%}{{ block.settings.image_collection2 | img_url: '1500x' }} 1500w,{%- endif -%}"
                        src="{{ block.settings.image_collection2 | img_url: 'master' }}"
                        sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                        alt="{{ block.settings.image_collection2.alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image_collection2.width }}"
                        height="{{ block.settings.image_collection2.height }}"
                        >
                        {%- else -%}
                        {%- capture current -%}{%- cycle 1, 2, 3, 4, 5, 6 -%}{%- endcapture -%}
                        {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                        </div>
                        <h3 class="title-collection-1 {% if block.settings.title_collection2 == "top" %} text-top {% else %} {% endif %} "><span class="{% if block.settings.add_border_bottom2 %} border-under {% endif %}">{{ block.settings.collection2.title | escape }}{%- if block.settings.collection.title == blank -%}<span>Collection</span>{%- endif -%}</span></h3>
                    </div>
                </a>
                </div>
                <!-- item 3 -->
                <div class="collection-1-content" style="background: {{ block.settings.bg_color_item3 }}; {% if block.settings.image_collection3 == blank and block.settings.collection3.url == blank %} display:none; {% endif %}">
                    <a class="link-collection-1" href="{{ block.settings.collection3.url | default:'#' }}">
                    <div class="flex-fake">
                        <div class="collection-content collection-{% if section.settings.effects_image %}image-hover{% else %}image{% endif %} {% if block.settings.image_collection != blank %}media{% else %}image-collection__media--placeholder placeholder{% endif %}" style="padding-bottom: {{ 1 | divided_by: block.settings.image_collection3.aspect_ratio | times: 100 }}%;" >
                        {%- if block.settings.image_collection3 != blank -%}
                        <img
                        srcset="{%- if block.settings.image_collection3.width >= 165 -%}{{ block.settings.image_collection3 | img_url: '165x' }} 165w,{%- endif -%}
                            {%- if block.settings.image_collection3.width >= 1500 -%}{{ block.settings.image_collection3 | img_url: '1500x' }} 1500w,{%- endif -%}"
                        src="{{ block.settings.image_collection3 | img_url: 'master' }}"
                        sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                        alt="{{ block.settings.image_collection3.alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image_collection3.width }}"
                        height="{{ block.settings.image_collection3.height }}"
                        >
                        {%- endif -%}
                        </div>
                        <h3 class="title-collection-1 {% if block.settings.title_collection3 == "top" %} text-top {% else %} {% endif %} "><span class="{% if block.settings.add_border_bottom3 %} border-under {% endif %}">{{ block.settings.collection3.title | escape }}</span></h3>
                    </div>
                </a>
                </div>
            </div>
            {%- endfor -%}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "t:sections.collection.name",
  "class": "spaced-section",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "t:sections.collection.settings.fullwidth.label",
      "default": false
    },
    {
      "id": "background-color",
      "type": "color",
      "label": "t:sections.collection.settings.background-color.label"
    },
    {
      "type": "text",
      "id": "margin_desktop",
      "label": "t:sections.collection.settings.margin_desktop.label",
      "info": "t:sections.collection.settings.margin_desktop.info"
    },
    {
      "type": "text",
      "id": "padding_desktop",
      "label": "t:sections.collection.settings.padding_desktop.label",
      "info": "t:sections.collection.settings.padding_desktop.info"
    },
    {
      "type": "text",
      "id": "margin_mobile",
      "label": "t:sections.collection.settings.margin_mobile.label",
      "info": "t:sections.collection.settings.margin_mobile.info"
    },
    {
      "type": "text",
      "id": "padding_mobile",
