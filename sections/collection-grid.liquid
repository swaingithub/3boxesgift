      "label": "t:sections.collection.settings.heading.label",
      "default": "Collection list 1"
    },
    {
      "type": "text",
      "id": "text_decoration",
      "label": "t:sections.collection.settings.text_decoration.label",
      "default": "Collection list 1"
    },
    {
    "type": "checkbox",
    "id": "effects_image",
    "label": "t:sections.collection.settings.effects_image.label",
    "default": false
    }
  ],
  "blocks": [
    {
        "type": "collection",
        "name": "t:sections.collection.blocks.collection.name",
        "settings": [
        {
        "type": "select",
        "id": "width",
        "label": "t:sections.collection.blocks.collection.settings.width.label",
        "default": "33%",
        "options": [
          {
            "value": "25%",
            "label": "t:sections.collection.blocks.collection.settings.width.options__1.label"
          },
          {
            "value": "33%",
            "label": "t:sections.collection.blocks.collection.settings.width.options__2.label"
          },
          {
            "value": "50%",
            "label": "t:sections.collection.blocks.collection.settings.width.options__3.label"
          },
          {
            "value": "66%",
            "label": "t:sections.collection.blocks.collection.settings.width.options__4.label"
          },
          {
            "value": "75%",
            "label": "t:sections.collection.blocks.collection.settings.width.options__5.label"
          },
          {
            "value": "100%",
            "label": "t:sections.collection.blocks.collection.settings.width.options__6.label"
          }
        ]
       },

       {
        "type": "color",
        "id": "bg_color_item",
        "label": "t:sections.collection-grid.blocks.collection.settings.bg_color_item.label"
        },
        {
            "type": "collection",
            "id": "collection",
            "label": "t:sections.collection.blocks.collection.settings.collection.label"
            },
            {
            "type": "image_picker",
            "id": "image_collection",
            "label": "t:sections.collection.blocks.collection.settings.image_collection.label"
            },
            {
                "type": "checkbox",
                "id": "add_border_bottom",
                "label": "t:sections.slide-show.blocks.image.settings.add_border_bottom.label",
                "default": false
              },
            {
                "type": "select",
                "id": "title_collection",
                "label": "t:sections.collection-grid.blocks.collection.settings.title_collection.label",
                "default": "bottom",
                "options": [
                  {
                    "value": "top",
                    "label": "t:sections.collection-grid.blocks.collection.settings.title_collection.options__1.label"
                  },
                  {
                    "value": "bottom",
                    "label": "t:sections.collection-grid.blocks.collection.settings.title_collection.options__3.label"
                  }
                ]
            },
            
            {
                "type": "color",
                "id": "bg_color_item2",
                "label": "t:sections.collection-grid.blocks.collection.settings.bg_color_item2.label"
                },
            {
                "type": "collection",
                "id": "collection2",
                "label": "t:sections.collection-grid.blocks.collection.settings.collection2.label"
            },
            {
                "type": "image_picker",
                "id": "image_collection2",
                "label": "t:sections.collection-grid.blocks.collection.settings.image_collection2.label"
            },
            {
                "type": "checkbox",
                "id": "add_border_bottom2",
                "label": "t:sections.slide-show.blocks.image.settings.add_border_bottom.label",
                "default": false
              },
            {
                "type": "select",
                "id": "title_collection2",
                "label": "t:sections.collection-grid.blocks.collection.settings.title_collection2.label",
                "default": "bottom",
                "options": [
                  {
                    "value": "top",
                    "label": "t:sections.collection-grid.blocks.collection.settings.title_collection2.options__1.label"
                  },
                  {
                    "value": "bottom",
                    "label": "t:sections.collection-grid.blocks.collection.settings.title_collection2.options__3.label"
                  }
                ]
            },



            {
                "type": "color",
                "id": "bg_color_item3",
                "label": "t:sections.collection-grid.blocks.collection.settings.bg_color_item3.label"
                },
            {
                "type": "collection",
                "id": "collection3",
                "label": "t:sections.collection-grid.blocks.collection.settings.collection3.label"
            },
            {
                "type": "image_picker",
                "id": "image_collection3",
                "label": "t:sections.collection-grid.blocks.collection.settings.image_collection3.label"
            },
            {
                "type": "checkbox",
                "id": "add_border_bottom3",
                "label": "t:sections.slide-show.blocks.image.settings.add_border_bottom.label",
                "default": false
              },
            {
                "type": "select",
                "id": "title_collection3",
                "label": "t:sections.collection-grid.blocks.collection.settings.title_collection3.label",
                "default": "bottom",
                "options": [
                  {
                    "value": "top",
                    "label": "t:sections.collection-grid.blocks.collection.settings.title_collection3.options__1.label"
                  },
                  {
                    "value": "bottom",
                    "label": "t:sections.collection-grid.blocks.collection.settings.title_collection3.options__3.label"
                  }
                ]
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-grid.presets.name",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
