<!-- slide-show.liquid -->
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<link rel="stylesheet" href="{{ 'slide-show-3.css' | asset_url }}" media="print" onload="this.media='all'">
{% render 'section-style' %}
<div class="slide-show-3" data-delay='{%- if section.settings.enberslidesDelay -%}{{ section.settings.slidesDelay }}{%- else -%}0{%- endif -%}' {% if section.settings.show_bg_slideshow %} style="background: url( {{ section.settings.bg_slideshow | img_url: 'master' }} );" {% endif %}>
  <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}larger-container{%- endif -%}">
    <div class="row">

      <!-- collection -->
      {%- if section.settings.show_collection -%}
        <div class="col-xl-3 col-lg-3 slide-show-3-item">
          <div class="row banner-content" >
              {%- for block in section.blocks -%}
              {% case block.type %}
                {% when "image" %}
                  {%- case block.settings.width -%}
                  {%- when '25%' -%}
                  {%- assign block_width = 'col-lg-3 col-sm-6' -%}
                  {%- when '33%' -%}
                  {%- assign block_width = 'col-lg-4 col-md-4' -%}
                  {%- when '50%' -%}
                  {%- assign block_width = 'col-lg-6 col-sm-12' -%}
                  {%- when '66%' -%}
                  {%- assign block_width = 'col-lg-8 col-md-12' -%}
                  {%- when '75%' -%}
                  {%- assign block_width = 'col-lg-9 col-md-9' -%}
                  {%- when '100%' -%}
                  {%- assign block_width = 'col-12' -%}
                  {%- endcase -%}
                  <div class="{{block_width}} banner-item" {{ block.shopify_attributes }}>
                      <div class="banner-image">
                      <div class="banner-grid-content{% if section.settings.effects_image %}{{ 'banner-image-hover' | prepend: ' ' }}{% endif %} {% if block.settings.image != blank %}media{% else %}image-banner-grid__media--placeholder placeholder{% endif %}" style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
                      >
                        {%- if block.settings.image != blank -%}
                        <img
                          srcset="{%- if block.settings.image.width >= 165 -%}{{ block.settings.image | img_url: '165x' }} 165w,{%- endif -%}
                            {%- if block.settings.image.width >= 360 -%}{{ block.settings.image | img_url: '360x' }} 360w,{%- endif -%}
                            {%- if block.settings.image.width >= 535 -%}{{ block.settings.image | img_url: '535x' }} 535w,{%- endif -%}
                            {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | img_url: '750x' }} 750w,{%- endif -%}
                            {%- if block.settings.image.width >= 1070 -%}{{ block.settings.image | img_url: '1070x' }} 1070w,{%- endif -%}
                            {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | img_url: '1500x' }} 1500w,{%- endif -%}"
                          src="{{ block.settings.image | img_url: 'master' }}"
                          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                          alt="{{ block.settings.image.alt | escape }}"
                          loading="lazy"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.height }}"
                        >
                        {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                          <div class="banner-grid d-flex flex-column {%- if block.settings.item_align == 'top' -%}{{ 'justify-content-start' | prepend: ' ' }}{%- elsif block.settings.item_align == 'center' -%}{{ 'justify-content-center' | prepend: ' ' }}{%- elsif block.settings.item_align == 'bottom' -%}{{ 'justify-content-end' | prepend: ' ' }}{%- endif -%}
                          {%- if block.settings.justify_content == 'left' -%}{{ 'align-items-start' | prepend: ' ' }}{%- elsif block.settings.justify_content == 'center' -%}{{ 'align-items-center' | prepend: ' ' }}{%- elsif block.settings.justify_content == 'right' -%}{{ 'align-items-end' | prepend: ' ' }}{%- endif -%}">
                              <div {% if block.settings.add_bg %} style="background:{{ block.settings.bg }};padding:10px;" {% endif %} class="slide-box {%- if block.settings.text_align == 'left' -%}{{ 'text-start' | prepend: ' ' }}{%- elsif block.settings.text_align == 'center' -%}{{ 'text-center' | prepend: ' ' }}{%- elsif block.settings.text_align == 'right' -%}{{ 'text-end' | prepend: ' ' }}{%- endif -%}">
                                  <h5>{{ block.settings.header_image }}</h5>
                                  <h3 style="padding: {{ block.settings.pd_title }}; ">{{ block.settings.subheader_image }}</h3>
                                  <p {% if block.settings.add_border_bottom %} class="border-under d-inline-block " {% endif %}>{{ block.settings.text_image }}</p>
                                  {%- if block.settings.btn_text != blank -%}
                                  <a class="button-content" href="{{ block.settings.btn_link | default:'#' }}" title="{{ block.settings.btn_text }}">
                                    <span>{{ block.settings.btn_text }}</span>
                                  </a>
                                  {%- endif -%}
                              
                              </div>
                          </div>
                          </div>
                      </div>
                  </div>
                {% endcase %}
              {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      <!-- slide -->
      <div class="{% if section.settings.show_collection %} col-xl-6 col-lg-6 slide-show-3-item {% else %} col-sm-12 {% endif %}">
        <div class="slide slide-slick ap-custom-slick apslick "
        data-setting='{"accessibility": false, "arrows": {{ section.settings.arrows }},
        "dots": {{ section.settings.dots }}, "draggable": {{ section.settings.draggable }},
        "infinite": {{ section.settings.infinite }}, "autoplay": {{ section.settings.autoplay }},
        "autoplaySpeed": {{ section.settings.autoplaySpeed }}, "speed": {{ section.settings.speed }},
        "slidesToShow": {{ section.settings.slidesToShow }}, "slidesToScroll": {{ section.settings.slidesToScroll }},
        "vertical": false, "mobileFirst": false, "pauseOnHover": {{ section.settings.pauseOnHover }},
        "rows": {{ section.settings.rows }}, "slidesPerRow": 1, "rtl": {% if settings.enable_rtl %}1{% else %}0{% endif %},
        "slidesToShow_992": {{ section.settings.slidesToShow_992 }}, "slidesToScroll_992": {{ section.settings.slidesToScroll_992 }},
        "arrows_992": {{ section.settings.arrows_992 }}, "dots_992": {{ section.settings.dots_992 }},
        "slidesToShow_767": {{ section.settings.slidesToShow_767 }}, "slidesToScroll_767": {{ section.settings.slidesToScroll_767 }},
        "arrows_767": {{ section.settings.arrows_767 }}, "dots_767": {{ section.settings.dots_767 }},
        "slidesToShow_450": {{ section.settings.slidesToShow_450 }}, "slidesToScroll_450": {{ section.settings.slidesToScroll_450 }},
        "arrows_450": {{ section.settings.arrows_450 }}, "dots_450": {{ section.settings.dots_450 }}}'>
            {%- for block in section.blocks -%}
            {% case block.type %}
              {% when "slide" %}
                <div class="slider-conten" id="ap-slick-content-{{block.id}}" {{ block.shopify_attributes }}>
                  <div class="slide-image {% if block.settings.image_slide != blank %}media{% else %}image-slide-show__media--placeholder placeholder{% endif %}" style="padding-bottom: {{ 1 | divided_by: block.settings.image_slide.aspect_ratio | times: 100 }}%;"
                  >
                    {%- if block.settings.image_slide != blank -%}
                    <img
                          srcset="{%- if block.settings.image.width >= 165 -%}{{ block.settings.image | img_url: '165x' }} 165w,{%- endif -%}
                          {%- if block.settings.image.width >= 360 -%}{{ block.settings.image | img_url: '360x' }} 360w,{%- endif -%}
                          {%- if block.settings.image.width >= 535 -%}{{ block.settings.image | img_url: '535x' }} 535w,{%- endif -%}
                          {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | img_url: '750x' }} 750w,{%- endif -%}
                          {%- if block.settings.image.width >= 1070 -%}{{ block.settings.image | img_url: '1070x' }} 1070w,{%- endif -%}
                          {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | img_url: '1500x' }} 1500w,{%- endif -%}"
                          src="{{ block.settings.image_slide | img_url: '1920x' }}"
                          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                          alt="{{ block.settings.image_slide.alt | escape }}"
                          loading="lazy"
                          width="{{ block.settings.image_slide.width }}"
                          height="{{ block.settings.image_slide.height }}"
                        >
                    {%- else -%}
                    {%- capture current -%}{%- cycle 1, 2 -%}{%- endcapture -%}
                          {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <div class="text-slider d-flex flex-column justify-content-{% if block.settings.item_align == 'top' %}start{% elsif block.settings.item_align == 'center' %}center{% elsif block.settings.item_align == 'bottom' %}end{% endif %} align-items-{%- if block.settings.box-align == 'left' -%}start{%- elsif block.settings.box-align == 'center' -%}center{%- elsif block.settings.box-align == 'right' -%}end{%- endif -%}">
                    <div class="box text-{%- if block.settings.text_align == 'left' -%}start{%- elsif block.settings.text_align == 'center' -%}center{%- elsif block.settings.text_align == 'right' -%}end{%- endif -%}">
                      <h4 class="sub-title-slide text-upper">{{ block.settings.sub_title }}</h4>
                      <h2 class="title-slide" style="margin: {{ block.settings.pd_title }}; " >{{ block.settings.title }}</h2>
                      <p class="description-slide text-upper">{{ block.settings.content }}</p>
                      {%- if block.settings.link != blank -%}
                      <a class="link-base link-{%- if block.settings.text_align == 'left' -%}left{%- elsif block.settings.text_align == 'center' -%}center{%- elsif block.settings.text_align == 'right' -%}right{%- endif -%}" href="{{ block.settings.btn_link | default:'#' }}" title="{{ block.settings.link }}">
                          {{ block.settings.link }}
                          <i class="leofar leofa-arrow-right"></i>
                        </a>
                      {%- endif -%}
                    </div>  
                  </div> 
                </div>
              {% endcase %}
            {%- endfor -%}
        </div>
      </div>
      <!-- collection 2 -->
      {%- if section.settings.show_collection -%}
        <div class="col-xl-3 col-lg-3 slide-show-3-item">
          <div class="row banner-content" >
              {%- for block in section.blocks -%}
              {% case block.type %}
                {% when "image2" %}
                  {%- case block.settings.width -%}
                  {%- when '25%' -%}
                  {%- assign block_width = 'col-lg-3 col-sm-6' -%}
                  {%- when '33%' -%}
                  {%- assign block_width = 'col-lg-4 col-md-4' -%}
                  {%- when '50%' -%}
                  {%- assign block_width = 'col-lg-6 col-sm-12' -%}
                  {%- when '66%' -%}
                  {%- assign block_width = 'col-lg-8 col-md-12' -%}
                  {%- when '75%' -%}
                  {%- assign block_width = 'col-lg-9 col-md-9' -%}
                  {%- when '100%' -%}
                  {%- assign block_width = 'col-12' -%}
                  {%- endcase -%}
                  <div class="{{block_width}} banner-item" {{ block.shopify_attributes }}>
                      <div class="banner-image">
                      <div class="banner-grid-content{% if section.settings.effects_image %}{{ 'banner-image-hover' | prepend: ' ' }}{% endif %} {% if block.settings.image != blank %}media{% else %}image-banner-grid__media--placeholder placeholder{% endif %}" style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
                      >
                        {%- if block.settings.image != blank -%}
                        <img
                          srcset="{%- if block.settings.image.width >= 165 -%}{{ block.settings.image | img_url: '165x' }} 165w,{%- endif -%}
                            {%- if block.settings.image.width >= 360 -%}{{ block.settings.image | img_url: '360x' }} 360w,{%- endif -%}
                            {%- if block.settings.image.width >= 535 -%}{{ block.settings.image | img_url: '535x' }} 535w,{%- endif -%}
                            {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | img_url: '750x' }} 750w,{%- endif -%}
                            {%- if block.settings.image.width >= 1070 -%}{{ block.settings.image | img_url: '1070x' }} 1070w,{%- endif -%}
                            {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | img_url: '1500x' }} 1500w,{%- endif -%}"
                          src="{{ block.settings.image | img_url: 'master' }}"
                          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                          alt="{{ block.settings.image.alt | escape }}"
                          loading="lazy"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.height }}"
                        >
                        {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                          <div class="banner-grid d-flex flex-column {%- if block.settings.item_align == 'top' -%}{{ 'justify-content-start' | prepend: ' ' }}{%- elsif block.settings.item_align == 'center' -%}{{ 'justify-content-center' | prepend: ' ' }}{%- elsif block.settings.item_align == 'bottom' -%}{{ 'justify-content-end' | prepend: ' ' }}{%- endif -%}
                          {%- if block.settings.justify_content == 'left' -%}{{ 'align-items-start' | prepend: ' ' }}{%- elsif block.settings.justify_content == 'center' -%}{{ 'align-items-center' | prepend: ' ' }}{%- elsif block.settings.justify_content == 'right' -%}{{ 'align-items-end' | prepend: ' ' }}{%- endif -%}">
                              <div {% if block.settings.add_bg %} style="background:{{ block.settings.bg }};padding:10px;" {% endif %} class="slide-box {%- if block.settings.text_align == 'left' -%}{{ 'text-start' | prepend: ' ' }}{%- elsif block.settings.text_align == 'center' -%}{{ 'text-center' | prepend: ' ' }}{%- elsif block.settings.text_align == 'right' -%}{{ 'text-end' | prepend: ' ' }}{%- endif -%}">
                                  <h5>{{ block.settings.header_image }}</h5>
                                  <h3 style="padding: {{ block.settings.pd_title }}; ">{{ block.settings.subheader_image }}</h3>
                                  <p {% if block.settings.add_border_bottom %} class="border-under d-inline-block" {% endif %}>{{ block.settings.text_image }}</p>
                                  {%- if block.settings.btn_text != blank -%}
                                  <a class="button-content" href="{{ block.settings.btn_link | default:'#' }}" title="{{ block.settings.btn_text }}">
                                    <span>{{ block.settings.btn_text }}</span>
                                  </a>
                                  {%- endif -%}
                              
                              </div>
                          </div>
                          </div>
                      </div>
                  </div>
                {% endcase %}
              {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      <!-- end -->
    </div>  
  </div>
</div>

{% schema %}
{
  "name": "t:sections.slide-show.name",
  "tag": "section",
  "class": "slide-show-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "t:sections.slide-show.settings.fullwidth.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bg_slideshow",
      "label": "t:sections.slide-show.settings.show_bg_slideshow.label",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "bg_slideshow",
      "label": "t:sections.slide-show.settings.bg_slideshow.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection",
      "label": "t:sections.slide-show.settings.show_collection.label",
      "default": false
    },
    {
      "type": "text",
      "id": "margin_desktop",
      "label": "t:sections.slide-show.settings.margin_desktop.label",
      "info": "t:sections.slide-show.settings.margin_desktop.info"
    },
    {
      "type": "text",
      "id": "padding_desktop",
      "label": "t:sections.slide-show.settings.padding_desktop.label",
      "info": "t:sections.slide-show.settings.padding_desktop.info"
    },
    {
      "type": "text",
      "id": "margin_mobile",
      "label": "t:sections.slide-show.settings.margin_mobile.label",
      "info": "t:sections.slide-show.settings.margin_mobile.info"
    },
    {
      "type": "text",
      "id": "padding_mobile",
      "label": "t:sections.slide-show.settings.padding_mobile.label",
      "info": "t:sections.slide-show.settings.padding_mobile.info"
    },
    {
      "type": "checkbox",
      "id": "enberslidesDelay",
      "label": "t:sections.slide-show.settings.enberslidesDelay.label",
      "default": true
    },
    {
      "type": "range",
      "id": "slidesDelay",
      "min": 10,
      "max": 20,
      "step": 1,
      "label": "t:sections.slide-show.settings.slidesDelay.label",
      "default": 15
    },
    {
      "type": "range",
      "id": "slidesToShow",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "t:sections.slide-show.settings.slidesToShow.label",
      "default": 1
    },
    {
      "type": "range",
      "id": "slidesToScroll",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "t:sections.slide-show.settings.slidesToScroll.label",
      "default": 1
    },
    {
      "type": "range",
      "id": "rows",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "t:sections.slide-show.settings.rows.label",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.slide-show.settings.autoplay.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplaySpeed",
      "min": 1000,
      "max": 5000,
      "step": 1000,
      "label": "t:sections.slide-show.settings.autoplaySpeed.label",
      "default": 5000
    },
    {
      "type": "range",
      "id": "speed",
      "min": 300,
      "max": 1000,
      "step": 100,
      "label": "t:sections.slide-show.settings.speed.label",
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "pauseOnHover",
      "label": "t:sections.slide-show.settings.pauseOnHover.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "t:sections.slide-show.settings.arrows.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "t:sections.slide-show.settings.dots.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "draggable",
      "label": "t:sections.slide-show.settings.draggable.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "t:sections.slide-show.settings.infinite.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.slide-show.settings.header.content"
    },
    {
      "type": "range",
      "id": "slidesToShow_992",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "t:sections.slide-show.settings.slidesToShow_992.label",
      "default": 1
    },
    {
      "type": "range",
      "id": "slidesToScroll_992",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "t:sections.slide-show.settings.slidesToScroll_992.label",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "arrows_992",
      "label": "t:sections.slide-show.settings.arrows_992.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dots_992",
      "label": "t:sections.slide-show.settings.dots_992.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.slide-show.settings.header_1.content"
    },
    {
      "type": "range",
      "id": "slidesToShow_767",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "t:sections.slide-show.settings.slidesToShow_767.label",
      "default": 1
    },
    {
      "type": "range",
      "id": "slidesToScroll_767",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "t:sections.slide-show.settings.slidesToScroll_767.label",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "arrows_767",
      "label": "t:sections.slide-show.settings.arrows_767.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dots_767",
      "label": "t:sections.slide-show.settings.dots_767.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.slide-show.settings.header_2.content"
    },
    {
      "type": "range",
      "id": "slidesToShow_450",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "t:sections.slide-show.settings.slidesToShow_450.label",
      "default": 1
    },
    {
      "type": "range",
      "id": "slidesToScroll_450",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "t:sections.slide-show.settings.slidesToScroll_450.label",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "arrows_450",
      "label": "t:sections.slide-show.settings.arrows_450.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dots_450",
      "label": "t:sections.slide-show.settings.dots_450.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slide-show.blocks.slide.name",
      "settings": [
      {
        "type": "image_picker",
        "id": "image_slide",
        "label": "t:sections.slide-show.blocks.slide.settings.image_slide.label"
      },
       {
          "type": "text",
          "id": "sub_title",
          "label": "t:sections.slide-show.blocks.slide.settings.sub_title.label",
          "default": "Sub-title slider-show"
        },
        {
          "type": "text",
          "id": "pd_title",
          "label": "t:sections.slide-show.blocks.slide.settings.pd_title.label",
          "info":"t:sections.slide-show.blocks.slide.settings.pd_title.info",
          "default": "0px 0px 20px 0px"
        },
        {
          "id": "title",
          "type": "text",
          "label": "t:sections.slide-show.blocks.slide.settings.title.label",
          "default": "Title slider-show"
        },
        {
          "id": "content",
          "type": "text",
          "label": "t:sections.slide-show.blocks.slide.settings.content.label",
          "default": "We are at the end of the ‘50s: an interesting series of armchairs and"
        },
        {
          "id": "link",
          "type": "text",
          "label": "t:sections.slide-show.blocks.slide.settings.link.label",
          "default": "Show More"
        },
        {
