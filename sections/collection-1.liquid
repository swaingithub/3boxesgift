<!-- collection.liquid -->

{{ 'collection-1.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{% render 'section-style' %}

<div class="collection-1">
    <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}" style="background: {{ section.settings.background-color }};">
      <h2 class="title-block">{{ section.settings.heading | escape }}</h2>
      <p class="section-text">{{ section.settings.text_decoration }}</p>
        <div class="row collection-1-row">
            {%- for block in section.blocks -%}
            {%- case block.settings.width -%}
            {%- when '25%' -%}
            {%- assign block_width = 'col-lg-3 col-md-3 col-sm-6 col-12' -%}
            {%- when '33%' -%}
            {%- assign block_width = 'col-lg-4 col-md-6' -%}
            {%- when '50%' -%}
            {%- assign block_width = 'col-lg-6' -%}
            {%- when '66%' -%}
            {%- assign block_width = 'col-lg-8 col-md-6' -%}
            {%- when '75%' -%}
            {%- assign block_width = 'col-lg-9 col-md-9' -%}
            {%- when '100%' -%}
            {%- assign block_width = 'col-xl-12 col-lg-3 col-md-6 col-sm-6 col-6' -%}
            {%- endcase -%}
            <div class="{{block_width}} collection-item">
              {%- assign collection_obj = collections[block.settings.collection] -%}
              {%- if collection_obj == blank or collection_obj.url == blank -%}
                {%- assign collection_obj = block.settings.collection -%}
              {%- endif -%}
              <div class="collection-1-content">
                  <a class="link-collection-1" href="{{ collection_obj.url | default:'#' }}">
                    <div class="flex-fake">
                      <div class="collection-content collection-{% if section.settings.effects_image %}image-hover{% else %}image{% endif %} {% if block.settings.image_collection != blank %}media{% else %}image-collection__media--placeholder placeholder{% endif %}" style="padding-bottom: {% if block.settings.image_collection != blank %}{{ 1 | divided_by: block.settings.image_collection.aspect_ratio | times: 100 }}{% else %}100{% endif %}%;" >
                        {%- if block.settings.image_collection != blank -%}
                        <img
                        srcset="{%- if block.settings.image_collection.width >= 165 -%}{{ block.settings.image_collection | img_url: '165x' }} 165w,{%- endif -%}
                          {%- if block.settings.image_collection.width >= 360 -%}{{ block.settings.image_collection | img_url: '360x' }} 360w,{%- endif -%}
                          {%- if block.settings.image_collection.width >= 535 -%}{{ block.settings.image_collection | img_url: '535x' }} 535w,{%- endif -%}
                          {%- if block.settings.image_collection.width >= 750 -%}{{ block.settings.image_collection | img_url: '750x' }} 750w,{%- endif -%}
                          {%- if block.settings.image_collection.width >= 1070 -%}{{ block.settings.image_collection | img_url: '1070x' }} 1070w,{%- endif -%}
                          {%- if block.settings.image_collection.width >= 1500 -%}{{ block.settings.image_collection | img_url: '1500x' }} 1500w,{%- endif -%}"
                        src="{{ block.settings.image_collection | img_url: 'master' }}"
                        sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                        alt="{{ block.settings.image_collection.alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image_collection.width }}"
                        height="{{ block.settings.image_collection.height }}"
                      >
                      {%- else -%}
                      {%- capture current -%}{%- cycle 1, 2, 3, 4, 5, 6 -%}{%- endcapture -%}
                      {%- if current == '1' -%}
                        <img src="https://images.unsplash.com/photo-1602928321679-560bb453f190?q=80&w=1000&auto=format&fit=crop" alt="Luxury Lit Candle" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top:0; left:0;">
                      {%- elsif current == '2' -%}
                        <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?q=80&w=1000&auto=format&fit=crop" alt="Minimalist Gift Ribbon" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top:0; left:0;">
                      {%- elsif current == '3' -%}
                        <img src="https://images.unsplash.com/photo-1512909006721-3d6018887383?q=80&w=1000&auto=format&fit=crop" alt="Fancy Wrapped Gift" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top:0; left:0;">
                      {%- elsif current == '4' -%}
                        <img src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?q=80&w=1000&auto=format&fit=crop" alt="Luxury Candles Setup" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top:0; left:0;">
                      {%- elsif current == '5' -%}
                        <img src="https://images.unsplash.com/photo-1577733966973-d680bffd2e80?q=80&w=1000&auto=format&fit=crop" alt="Premium Gold Gift Set" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top:0; left:0;">
                      {%- else -%}
                        <img src="https://images.unsplash.com/photo-1603052875302-d376b7c0638a?q=80&w=1000&auto=format&fit=crop" alt="Small Luxury Aesthetic Candle" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top:0; left:0;">
                      {%- endif -%}
                      {%- endif -%}
                      </div>
                      <h3 class="title-collection-1 {% if block.settings.title_collection == "top" %} text-top  {% endif %} " {% if block.settings.show_border_bottom %} style="border-bottom: 1px solid {{ block.settings.color_text }};" {%- endif -%}>
                        <span style=" color: {{ block.settings.color_text }};padding-bottom:{{ block.settings.pd_bottom }}px;">{{ collection_obj.title | escape }}{%- if collection_obj.title == blank -%}<span>Collection</span>{%- endif -%}</span>
                        <span class="count">{{ collection_obj.products_count | default: 0 }} items</span>
                      </h3>
                    </div>
                </a>
              </div>
            </div>
            {%- endfor -%}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "t:sections.collection.name",
  "class": "spaced-section",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "t:sections.collection.settings.fullwidth.label",
      "default": false
    },
    {
      "id": "background-color",
      "type": "color",
      "label": "t:sections.collection.settings.background-color.label"
    },
    {
      "type": "text",
      "id": "margin_desktop",
      "label": "t:sections.collection.settings.margin_desktop.label",
      "info": "t:sections.collection.settings.margin_desktop.info"
    },
    {
      "type": "text",
      "id": "padding_desktop",
      "label": "t:sections.collection.settings.padding_desktop.label",
      "info": "t:sections.collection.settings.padding_desktop.info"
    },
    {
      "type": "text",
      "id": "margin_mobile",
      "label": "t:sections.collection.settings.margin_mobile.label",
      "info": "t:sections.collection.settings.margin_mobile.info"
    },
    {
      "type": "text",
      "id": "padding_mobile",
      "label": "t:sections.collection.settings.padding_mobile.label",
      "info": "t:sections.collection.settings.padding_mobile.info"
    },
    {
      "id": "heading",
      "type": "text",
      "label": "t:sections.collection.settings.heading.label",
      "default": "Collection list 1"
    },
    {
      "type": "text",
      "id": "text_decoration",
      "label": "t:sections.collection.settings.text_decoration.label",
      "default": "Collection list 1"
    },
    {
    "type": "checkbox",
    "id": "effects_image",
    "label": "t:sections.collection.settings.effects_image.label",
    "default": false
    }
  ],
  "blocks": [
    {
        "type": "collection",
        "name": "t:sections.collection.blocks.collection.name",
        "settings": [
        {
        "type": "select",
        "id": "width",
        "label": "t:sections.collection.blocks.collection.settings.width.label",
        "default": "33%",
        "options": [
          {
            "value": "25%",
            "label": "t:sections.collection.blocks.collection.settings.width.options__1.label"
          },
          {
            "value": "33%",
            "label": "t:sections.collection.blocks.collection.settings.width.options__2.label"
          },
          {
            "value": "50%",
            "label": "t:sections.collection.blocks.collection.settings.width.options__3.label"
          },
          {
            "value": "66%",
            "label": "t:sections.collection.blocks.collection.settings.width.options__4.label"
          },
          {
            "value": "75%",
            "label": "t:sections.collection.blocks.collection.settings.width.options__5.label"
          },
          {
            "value": "100%",
            "label": "t:sections.collection.blocks.collection.settings.width.options__6.label"
          }
        ]
       },
        {
            "type": "collection",
            "id": "collection",
            "label": "t:sections.collection.blocks.collection.settings.collection.label"
            },
            {
              "type": "select",
              "id": "title_collection",
              "label": "t:sections.collection.blocks.collection.settings.title_collection.label",
              "default": "bottom",
              "options": [
                {
                  "value": "top",
                  "label": "t:sections.collection.blocks.collection.settings.title_collection.options__1.label"
                },
                {
                  "value": "bottom",
                  "label": "t:sections.collection.blocks.collection.settings.title_collection.options__3.label"
                }
              ]
             },
             {
              "type": "color",
              "id": "color_text",
              "label": "t:sections.collection.blocks.collection.settings.color_text.label"
              },
             {
              "type": "checkbox",
              "id": "show_border_bottom",
              "label": "t:sections.collection.blocks.collection.settings.show_border_bottom.label"
              },
              {
                "type": "text",
                "id": "pd_bottom",
                "label": "t:sections.collection.blocks.collection.settings.pd_bottom.label",
                "default":"0"
                },
            {
            "type": "image_picker",
            "id": "image_collection",
            "label": "t:sections.collection.blocks.collection.settings.image_collection.label"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection.presets.name",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
